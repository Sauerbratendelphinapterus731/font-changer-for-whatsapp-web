{
  "manifest_version": 3,
  "name": "Font Changer for WhatsApp Web",
  "version": "1.0.0",
  "description": "Change the font, size, and weight of WhatsApp Web text. Your choice is remembered across sessions.",
  "permissions": ["storage", "fontSettings"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Font Changer for WhatsApp Web"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
